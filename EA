// ---- EJES CON COORDENADAS REALES (-3 a 7) ----
// Dibuja las líneas de los ejes, los ticks (marcas) cada unidad entera,
// y las etiquetas numéricas en los bordes del canvas.
// Los MÁRGENES definidos arriba son los que crean el espacio para esto.
// x2px() e y2py() usan esos mismos márgenes, así los puntos de la
// población siempre quedan alineados visualmente con la escala.
void dibujarEjes() {
  stroke(180); strokeWeight(1); fill(180); textSize(10);

  // Eje X (horizontal, en el borde inferior)
  textAlign(CENTER, TOP);
  line(MARGEN_IZQ, height-MARGEN_INF, width-MARGEN_DER, height-MARGEN_INF);
  for (int v = (int)X_MIN; v <= (int)X_MAX; v++) {
    float px = x2px(v);
    line(px, height-MARGEN_INF, px, height-MARGEN_INF+5); // tick
    text(v, px, height-MARGEN_INF+7);                     // etiqueta numérica
  }
  textAlign(CENTER, BOTTOM);
  text("x", width/2, height-2); // nombre del eje

  // Eje Y (vertical, en el borde izquierdo)
  textAlign(RIGHT, CENTER);
  line(MARGEN_IZQ, MARGEN_SUP, MARGEN_IZQ, height-MARGEN_INF);
  for (int v = (int)Y_MIN; v <= (int)Y_MAX; v++) {
    float py = y2py(v);
    line(MARGEN_IZQ-5, py, MARGEN_IZQ, py); // tick
    text(v, MARGEN_IZQ-7, py);              // etiqueta numérica
  }
  // Etiqueta "y" rotada 90° con pushMatrix/popMatrix para no afectar el resto
  pushMatrix();
  translate(12, height/2);
  rotate(-HALF_PI);
  textAlign(CENTER, CENTER);
  text("y", 0, 0);
  popMatrix();

  noStroke();
}

// ---- Dibuja el mejor global (cruz roja) y el mínimo teórico (verde) ----
// Inspirado en despliegaBest() del PSO del profe
void mostrarBest() {
  // Mejor encontrado: cruz roja
  float bx = x2px(gbestx), by = y2py(gbesty);
  stroke(255,0,0); strokeWeight(2); noFill();
  line(bx-10,by,bx+10,by);
  line(bx,by-10,bx,by+10);
  ellipse(bx,by,18,18);

  // Mínimo teórico en (0,0): círculo verde para comparar visualmente
  stroke(0,255,150); strokeWeight(1.5);
  ellipse(x2px(0),y2py(0),14,14);

  strokeWeight(1); noStroke();
}

// ---- Muestra estadísticas y estado del log en pantalla ----
// El panel crece verticalmente cuando hay información del Excel para mostrar.
void mostrarInfo() {
  // Altura del panel: crece si hay algo que decir sobre el Excel
  int panelH = (guardando || (!rutaExcel.isEmpty())) ? 145 : 105;
  fill(0,0,0,160); noStroke();
  rect(MARGEN_IZQ+8, MARGEN_SUP+8, 280, panelH, 6);

  PFont f = createFont("Monospaced", 13, true);
  textFont(f, 13); fill(0,255,0); textAlign(LEFT);
  int lx = MARGEN_IZQ+16, ly = MARGEN_SUP+26;
  text("Generacion:   " + generacion + " / " + MAX_GEN,           lx, ly);
  text("Poblacion:    " + N,                                       lx, ly+16);
  text("Seleccion:    " + (RULETA ? "Ruleta" : "Torneo K="+K),    lx, ly+32);
  text("gBest f(x,y): " + nf(gbest, 1, 4),                       lx, ly+48);
  text("  en (" + nf(gbestx,1,2) + " , " + nf(gbesty,1,2) + ")", lx, ly+64);

  // Estado del Excel — cambia según la fase del proceso
  if (guardando) {
    // Python está corriendo: muestra aviso en amarillo
    fill(255,200,0); textSize(11);
    text("Generando Excel...", lx, ly+88);
  } else if (yaGuardo && !rutaExcel.isEmpty()) {
    boolean esError = rutaExcel.startsWith("ERROR");
    // Verde = éxito, rojo = error
    fill(esError ? color(255,80,80) : color(80,255,120));
    textSize(11);
    text(esError ? rutaExcel : "Excel listo!", lx, ly+88);
    if (!esError) {
      // Muestra la ruta del archivo en dos líneas si es muy larga
      fill(160); textSize(10);
      String ruta = rutaExcel;
      int corte = ruta.lastIndexOf(
        System.getProperty("os.name").toLowerCase().contains("win") ? "\\" : "/");
      text(ruta.substring(0, corte+1), lx, ly+104); // carpeta
      text(ruta.substring(corte+1),   lx, ly+120);  // nombre del archivo
    }
  }

  // Instrucciones al pie
  fill(200); textSize(10); textAlign(CENTER);
  text("ESPACIO: paso  |  A: auto/pausa  |  R: reset  |  T: cambiar selección  |  G: guardar ahora",
       width/2, height-5);
}

// ---- Genera la imagen de fondo con el mapa de calor de Rastrigin ----
// Calculamos directamente de la función Rastrigin en cada píxel.
// Se hace en dos pasadas: primero encontrar el rango (min/max),
// luego colorear normalizando entre 0 y 1.
// Azul oscuro = valor bajo (mínimos), rojo = valor alto (máximos).
// El tamaño de la imagen respeta los MÁRGENES para que el mapa
// quede alineado con los ejes dibujados en dibujarEjes().
PImage generarMapaCalor() {
  int mw = width  - MARGEN_IZQ - MARGEN_DER;
  int mh = height - MARGEN_INF - MARGEN_SUP;
  PImage img = createImage(mw, mh, RGB);
  img.loadPixels();

  // Primera pasada: calcular todos los valores y encontrar el rango
  float minF =  Float.MAX_VALUE;
  float maxF = -Float.MAX_VALUE;
  float[][] vals = new float[mw][mh];
  for (int px = 0; px < mw; px++) {
    for (int py = 0; py < mh; py++) {
      float x  = map(px, 0, mw, X_MIN, X_MAX);
      float y  = map(py, 0, mh, Y_MAX, Y_MIN); // Y invertido (px 0 = arriba)
      float fv = 20+(x*x-10*cos(TWO_PI*x))+(y*y-10*cos(TWO_PI*y));
      vals[px][py] = fv;
      if (fv < minF) minF = fv;
      if (fv > maxF) maxF = fv;
    }
  }

  // Segunda pasada: colorear según el valor normalizado
  for (int px = 0; px < mw; px++) {
    for (int py = 0; py < mh; py++) {
      float t = map(vals[px][py], minF, maxF, 0, 1);
      img.pixels[py * mw + px] = colorCalor(t);
    }
  }
  img.updatePixels();
  return img;
}

// ---- Paleta de colores del mapa de calor ----
// t=0 (mínimo global) -> azul oscuro
// t=0.5               -> verde
// t=1 (máximo)        -> rojo
color colorCalor(float t) {
  if (t < 0.33) return lerpColor(color(10, 30, 120),  color(20, 180, 80),  map(t, 0, 0.33, 0, 1));
  if (t < 0.66) return lerpColor(color(20, 180, 80),  color(240, 200, 20), map(t, 0.33, 0.66, 0, 1));
               return lerpColor(color(240, 200, 20), color(200, 20, 20),  map(t, 0.66, 1.0, 0, 1));
}

// ---- Conversiones dominio ↔ píxel ----
// Usan los MÁRGENES para que la posición (0,0) por ejemplo
// caiga exactamente sobre el tick "0" de ambos ejes visuales.
float x2px(float x) { return map(x, X_MIN, X_MAX, MARGEN_IZQ, width-MARGEN_DER); }
float y2py(float y) { return map(y, Y_MIN, Y_MAX, height-MARGEN_INF, MARGEN_SUP); } // Y invertido

// =====================================================================
// CONTROLES DE TECLADO
// =====================================================================
void keyPressed() {
  if (key == ' ') {
    // Avanza UNA generación manualmente (útil para ver el proceso paso a paso)
    if (generacion < MAX_GEN) siguienteGeneracion();
    // Si llegó al final con avance manual, también genera el Excel
    if (generacion >= MAX_GEN && !yaGuardo) {
      yaGuardo = guardando = true;
      generarExcelAutomatico();
    }
  }
  if (key=='a'||key=='A') {
    // Activa o pausa el modo automático (avanza sola)
    corriendo = !corriendo;
  }
  if (key=='r'||key=='R') {
    // Reinicia todo desde cero con nueva población aleatoria
    inicializar();
    surf = generarMapaCalor(); // recalcula si cambiaste dominio
  }
  if (key=='t'||key=='T') {
    // Alterna entre selección por Ruleta y por Torneo
    RULETA = !RULETA;
  }
  if ((key=='g'||key=='G') && !yaGuardo) {
    // Fuerza el guardado en cualquier momento (útil a mitad del experimento)
    yaGuardo = guardando = true;
    generarExcelAutomatico();
  }
}
